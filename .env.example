# Copy to .env.local and fill in. This file is committed — keep it placeholders only.

# One Aptos API key (Geomi) authenticates all three paths: the SDK, the
# WebSocket subprotocol, and Decibel's REST API. They share a host and an auth
# boundary, so the "node key" and "bearer token" the docs describe separately
# are the same credential.
APTOS_API_KEY=

# Signs transactions. Holds APT for gas; holds no collateral.
# AIP-80 format, e.g. ed25519-priv-0x...
API_WALLET_PRIVATE_KEY=
# Not read by the app — only needed for the subaccount lookup below.
API_WALLET_ADDRESS=

# The trading account (subaccount) holding the USDC and owning the positions.
# NOT the wallet address. Discover it from /subaccounts?owner=<API_WALLET_ADDRESS>.
DECIBEL_SUBACCOUNT_ADDR=

# Builder code: must also be a subaccount address, not a wallet address.
BUILDER_SUBACCOUNT_ADDR=
BUILDER_MAX_FEE_BPS=10
